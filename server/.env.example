# Vercel AI Gateway API key. Required to actually mint transcription tokens
# (POST /api/transcribe/token). Without it, that endpoint returns a
# structured 502 upstream_error — every other endpoint works fine.
AI_GATEWAY_API_KEY=

# HS256 signing secret for session JWTs (see lib/auth.ts). Required for every
# authenticated endpoint. Use a long random string in production.
PROSIO_JWT_SECRET=dev-secret-change-me

# Set to "1" to enable POST /api/auth/dev (email -> sessionToken, no real
# auth). Must be unset/anything else in production. 404s when not "1".
PROSIO_DEV_AUTH=1

# Postgres connection string (Neon). When unset, the backend falls back to
# an in-memory store (fine for local dev and tests, not persisted).
DATABASE_URL=
